<mxfile>
  <diagram name="Game Flow" id="gameflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="30" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- Title Screen -->
        <mxCell id="title" value="Title Screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="start" target="title" parent="1"/>

        <!-- Main Menu -->
        <mxCell id="menu" value="Main Menu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="210" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="title" target="menu" parent="1"/>

        <!-- New Game -->
        <mxCell id="newgame" value="New Game" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="310" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e3" edge="1" source="menu" target="newgame" parent="1"/>

        <!-- Continue / Load Game -->
        <mxCell id="continue" value="Continue /&#xa;Load Game" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="310" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e4" edge="1" source="menu" target="continue" parent="1"/>

        <!-- Quit / Exit Game -->
        <mxCell id="quit" value="Quit /&#xa;Exit Game" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="310" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e5" edge="1" source="menu" target="quit" parent="1"/>

        <!-- End -->
        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="575" y="440" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e6" edge="1" source="quit" target="end" parent="1"/>

        <!-- Check save -->
        <mxCell id="checksave" value="Check if there's&#xa;any game saved" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="170" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e7" edge="1" source="continue" target="checksave" parent="1"/>

        <!-- No save -> Create New Game? -->
        <mxCell id="createnew" value="Create a&#xa;New Game?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="170" width="130" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="No" style="fontSize=11;" edge="1" source="checksave" target="createnew" parent="1"/>
        <mxCell id="e8b" value="No" style="fontSize=11;edgeStyle=orthogonalEdgeStyle;" edge="1" source="createnew" target="menu" parent="1"/>

        <!-- Cutscene -->
        <mxCell id="cutscene" value="Cutscene /&#xa;Introduction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="440" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e9" edge="1" source="newgame" target="cutscene" parent="1"/>

        <!-- Gameplay Start -->
        <mxCell id="gpstart" value="Gameplay Start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="530" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e10" edge="1" source="cutscene" target="gpstart" parent="1"/>

        <!-- Gameplay -->
        <mxCell id="gameplay" value="Gameplay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="620" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e11" edge="1" source="gpstart" target="gameplay" parent="1"/>
        <mxCell id="e11b" value="Yes" style="fontSize=11;" edge="1" source="checksave" target="gameplay" parent="1"/>
        <mxCell id="e11c" value="Yes" style="fontSize=11;" edge="1" source="createnew" target="gameplay" parent="1"/>

        <!-- Detected by gangster? -->
        <mxCell id="detected" value="Detected by&#xa;a gangster?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="720" width="140" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e12" edge="1" source="gameplay" target="detected" parent="1"/>

        <!-- Reached Exit? -->
        <mxCell id="exit" value="Reached&#xa;Exit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="870" width="120" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="No" style="fontSize=11;" edge="1" source="detected" target="exit" parent="1"/>

        <!-- Alert Increases -->
        <mxCell id="alertinc" value="Alert Increases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="740" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="Yes" style="fontSize=11;" edge="1" source="detected" target="alertinc" parent="1"/>

        <!-- Evade / Fight NPC -->
        <mxCell id="evadefight" value="Evade / Fight&#xa;NPC" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="840" width="140" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e15" edge="1" source="alertinc" target="evadefight" parent="1"/>

        <!-- Alert Fails -->
        <mxCell id="alertfails" value="Alert Fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="990" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="Yes" style="fontSize=11;" edge="1" source="evadefight" target="alertfails" parent="1"/>

        <!-- Alert Rises -->
        <mxCell id="alertrises" value="Alert Rises" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="990" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e17" value="No" style="fontSize=11;" edge="1" source="evadefight" target="alertrises" parent="1"/>

        <!-- Other Gangsters Aware -->
        <mxCell id="othersaware" value="Other Gangsters&#xa;Aware / Alerted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="1080" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e18" edge="1" source="alertrises" target="othersaware" parent="1"/>

        <!-- Alert Reaches Maximum? -->
        <mxCell id="alertmax" value="Alert Reaches&#xa;Maximum?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="1060" width="150" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e19" edge="1" source="othersaware" target="alertmax" parent="1"/>

        <!-- Hunter Activated -->
        <mxCell id="hunteractive" value="Hunter Activated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="1040" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e20" value="Yes" style="fontSize=11;" edge="1" source="alertmax" target="hunteractive" parent="1"/>

        <!-- Hunter Pursues Player -->
        <mxCell id="hunterpursue" value="Hunter Pursues&#xa;Player" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="1040" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e21" edge="1" source="hunteractive" target="hunterpursue" parent="1"/>

        <!-- Continue Exploring -->
        <mxCell id="contexp" value="Continue&#xa;Exploring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="1190" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e22" value="No" style="fontSize=11;" edge="1" source="alertmax" target="contexp" parent="1"/>

        <!-- Continue Exploring -> Gameplay loop -->
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="contexp" target="gameplay" parent="1"/>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
